+/** Govern Core extension: one atomic JS budget shared by parent/child loops. */
+export class SharedBudget {
+  usedTokens = 0;
+  reservedTokens = 0;
+  turns = 0;
+  tools = 0;
+  readonly controller = new AbortController();
+  readonly started = Date.now();
+  constructor(readonly limits = { tokens: 120000, turns: 60, tools: 100, milliseconds: 900000 }) {}
+  check(): void {
+    if (this.controller.signal.aborted) throw this.controller.signal.reason instanceof Error ? this.controller.signal.reason : new Error("Govern budget cancelled");
+    if (Date.now() - this.started > this.limits.milliseconds) this.exhaust("time");
+  }
+  private exhaust(kind: string): never {
+    const error = new Error(`Govern shared ${kind} budget exhausted`);
+    this.controller.abort(error);
+    throw error;
+  }
+  reserve(messages: unknown[], output: number): { settle: (actual?: number) => void } {
+    this.check();
+    const amount = Math.ceil(JSON.stringify(messages).length / 2) + output;
+    if (this.turns >= this.limits.turns) this.exhaust("turn");
+    if (this.usedTokens + this.reservedTokens + amount > this.limits.tokens) this.exhaust("token");
+    this.turns++; this.reservedTokens += amount;
+    let settled = false;
+    return { settle: (actual?: number) => {
+      if (settled) return;
+      settled = true; this.reservedTokens -= amount;
+      this.usedTokens += actual === undefined ? amount : Math.max(0, actual);
+      if (this.usedTokens + this.reservedTokens > this.limits.tokens) this.exhaust("token");
+    }};
+  }
+  async reserveAsync(messages: unknown[], output: number, signal?: AbortSignal): Promise<{ settle: (actual?: number) => void }> {
+    const amount = Math.ceil(JSON.stringify(messages).length / 2) + output;
+    while (true) {
+      this.check();
+      if (signal?.aborted) throw new Error('Govern request cancelled');
+      if (this.usedTokens + amount > this.limits.tokens || !this.reservedTokens ||
+          this.usedTokens + this.reservedTokens + amount <= this.limits.tokens) return this.reserve(messages, output);
+      // Temporary contention is admission backpressure, not global exhaustion.
+      await new Promise(resolve => setTimeout(resolve, 20));
+    }
+  }
+  remainingTools(): number {
+    this.check();
+    return Math.max(0, this.limits.tools - this.tools);
+  }
+  tryTakeTool(): boolean {
+    this.check();
+    if (this.remainingTools() < 1) return false;
+    this.tools++;
+    return true;
+  }
+  takeTool(): void {
+    this.check();
+    if (this.tools >= this.limits.tools) this.exhaust("tool");
+    this.tools++;
+  }
+}
