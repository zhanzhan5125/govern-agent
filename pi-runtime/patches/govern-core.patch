diff --git a/packages/agent/src/govern-budget.ts b/packages/agent/src/govern-budget.ts
new file mode 100644
--- /dev/null
+++ b/packages/agent/src/govern-budget.ts
@@ -0,0 +1,37 @@
+/** Govern Core extension: one atomic JS budget shared by parent/child loops. */
+export class SharedBudget {
+  usedTokens = 0;
+  reservedTokens = 0;
+  turns = 0;
+  tools = 0;
+  readonly controller = new AbortController();
+  readonly started = Date.now();
+  constructor(readonly limits = { tokens: 120000, turns: 60, tools: 100, milliseconds: 900000 }) {}
+  check(): void {
+    if (this.controller.signal.aborted) throw new Error("Govern budget cancelled");
+    if (Date.now() - this.started > this.limits.milliseconds) this.exhaust("time");
+  }
+  private exhaust(kind: string): never {
+    this.controller.abort();
+    throw new Error(`Govern shared ${kind} budget exhausted`);
+  }
+  reserve(messages: unknown[], output: number): { settle: (actual?: number) => void } {
+    this.check();
+    const amount = Math.ceil(JSON.stringify(messages).length / 2) + output;
+    if (this.turns >= this.limits.turns) this.exhaust("turn");
+    if (this.usedTokens + this.reservedTokens + amount > this.limits.tokens) this.exhaust("token");
+    this.turns++; this.reservedTokens += amount;
+    let settled = false;
+    return { settle: (actual?: number) => {
+      if (settled) return;
+      settled = true; this.reservedTokens -= amount;
+      this.usedTokens += actual === undefined ? amount : Math.max(0, actual);
+      if (this.usedTokens + this.reservedTokens > this.limits.tokens) this.exhaust("token");
+    }};
+  }
+  takeTool(): void {
+    this.check();
+    if (this.tools >= this.limits.tools) this.exhaust("tool");
+    this.tools++;
+  }
+}
